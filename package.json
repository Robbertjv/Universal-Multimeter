{
  "name": "universal-multimeter-web-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,css}\" \"*.{js,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"*.{js,json,html}\"",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.2",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
